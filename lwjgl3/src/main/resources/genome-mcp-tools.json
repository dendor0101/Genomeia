[
  {
    "name": "get_status",
    "description": "Read the connected window, available state views and current draft IDs.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "get_catalog",
    "description": "Read selectable cell and formula keys, authoring rules and a working two-cell genome.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "list_genomes",
    "description": "Read player and bundled library names.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "read_genome",
    "description": "Read ordered growth instructions (stages) or the grown cell geometry (cells). Coordinates are in game units centered on the adult body.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Exact library name (including bundled/ prefix), draft UUID prefixed draft:, or editor: for the open editor."
        },
        "view": {
          "enum": [
            "stages",
            "cells"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "read_state",
    "description": "Read an actual game state between ticks. World cells include energy, velocity, organism, cell ID and neural output. Links identify endpoints. In the genome editor this shows the computed adult body. Pages are sampled at the tick returned; pause to inspect across pages.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "view": {
          "enum": [
            "cells",
            "links",
            "neuralLinks",
            "organisms"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "create_genome",
    "description": "Create an immutable draft from ordered stages. Use get_catalog for a working example. Submit revised stages to create a new draft. Up to eight recent drafts are retained.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "New library name"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "properties": {
              "cellActions": {
                "type": "object",
                "description": "Keys are source cell genome IDs alive at the start of this stage. Root = 0.",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "divide": {
                      "$ref": "#/$defs/action"
                    },
                    "mutate": {
                      "$ref": "#/$defs/action"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "cellActions"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name",
        "stages"
      ],
      "additionalProperties": false,
      "$defs": {
        "action": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": -1,
              "maximum": 4096
            },
            "angle": {
              "type": "number",
              "description": "Division angle in radians, relative to the parent."
            },
            "cellType": {
              "type": "string",
              "description": "Cell key from get_catalog"
            },
            "radius": {
              "type": "number",
              "maximum": 0.5,
              "minimum": 0.2
            },
            "angleDirected": {
              "type": "number"
            },
            "physicalLink": {
              "type": "object",
              "description": "Map from other genome cell id to link {length, isNeuronal, directedNeuronLink, weight}; null removes a link on mutation.",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "length": {
                        "type": "number",
                        "minimum": 0.001,
                        "maximum": 8
                      },
                      "isNeuronal": {
                        "type": "boolean"
                      },
                      "directedNeuronLink": {
                        "type": "integer"
                      },
                      "weight": {
                        "type": "number"
                      },
                      "color": {
                        "type": "integer"
                      },
                      "isExtra": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            "funActivation": {
              "type": "string",
              "description": "Formula key"
            },
            "a": {
              "type": "number"
            },
            "b": {
              "type": "number"
            },
            "c": {
              "type": "number"
            },
            "isSum": {
              "type": "boolean"
            },
            "color": {
              "type": "integer",
              "description": "Signed packed ABGR"
            },
            "pheromoneType": {
              "type": "integer",
              "minimum": -1,
              "maximum": 31
            },
            "colorRecognition": {
              "type": "integer"
            },
            "lengthDirected": {
              "type": "number"
            },
            "special": {
              "type": "object",
              "description": "Optional typed game cell settings as returned by read_genome. Use the defaults when unspecified."
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  {
    "name": "validate_genome",
    "description": "Run the game's growth calculation and return adult cell/link counts. Open the main menu or Genomes before the first validation.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Exact library name (including bundled/ prefix), draft UUID prefixed draft:, or editor: for the open editor."
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "preview_genome",
    "description": "Return a PNG image of the actual baked body.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Exact library name (including bundled/ prefix), draft UUID prefixed draft:, or editor: for the open editor."
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "save_genome",
    "description": "Save a validated draft in the player's library and return its exact catalog ID. From the menu opens Genomes. Existing files are retained.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Exact library name (including bundled/ prefix), draft UUID prefixed draft:, or editor: for the open editor."
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "read_growth",
    "description": "Inspect cells at a specific recorded growth frame of a draft or the currently open editor (editor:). Reports lastTick. Positions use the editor's displayed layout; this is growth, not a locomotion trial.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "draft:<uuid> or editor:"
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "measure_organism",
    "description": "Measure one live body's centroid, velocity, energy, type counts and growth stage between ticks. Find organism slot and generation via read_state with view=organisms. Repeat with the same generation to compare movement.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "organism": {
          "type": "integer",
          "minimum": 0
        },
        "generation": {
          "type": "integer"
        }
      },
      "required": [
        "organism"
      ],
      "additionalProperties": false
    }
  }
]
